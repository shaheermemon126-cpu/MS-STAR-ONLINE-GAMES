* {
    box-sizing: border-box;
}

body {
    margin: 0;
    font-family: Arial, sans-serif;
    background: #0f172a;
    color: white;
}

header {
    text-align: center;
    padding: 40px 20px;
    background: #111827;
}

header h1 {
    margin: 0;
    font-size: 32px;
}

header p {
    color: #cbd5e1;
}

main {
    max-width: 1100px;
    margin: auto;
    padding: 25px;
}

.games {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
    gap: 20px;
}

.game-card {
    background: #1e293b;
    padding: 20px;
    border-radius: 15px;
    text-align: center;
}

.game-image {
    height: 150px;
    display: flex;
    justify-content: center;
    align-items: center;
    font-size: 70px;
    background: #334155;
    border-radius: 12px;
}

.game-card h2 {
    margin-bottom: 5px;
}

.game-card p {
    color: #cbd5e1;
}

.play-button,
.disabled-button {
    display: inline-block;
    margin-top: 10px;
    padding: 12px 22px;
    border: none;
    border-radius: 8px;
    background: #2563eb;
    color: white;
    text-decoration: none;
    font-size: 16px;
    cursor: pointer;
}

.disabled-button {
    background: #475569;
}

.install {
    margin-top: 30px;
    padding: 25px;
    background: #1e293b;
    border-radius: 15px;
    text-align: center;
}

footer {
    text-align: center;
    padding: 25px;
    color: #94a3b8;
}
